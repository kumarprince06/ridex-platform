{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.import.gradle.enabled": false,
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/android/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**"
    ],
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/android/**": true,
        "**/target/**": true,
        "**/build/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/android/build": true,
        "**/target": true
    }
}
