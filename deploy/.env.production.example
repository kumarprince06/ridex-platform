# The demo deployment's secrets. Copy to .env.production on the host and fill it in.
#
# None of these belong in the repository. The values in the development .env have sat in plaintext
# next to a git working tree, so generate fresh ones here rather than copying them across - a
# leaked SMTP key sends spam from your own domain, whatever it was leaked from.

# Postgres password for the ridex_app role. Any long random string.
#   openssl rand -base64 24
RIDEX_APP_PASSWORD=

# JWT signing key, 32+ bytes. The app refuses to boot without it rather than signing with a default.
#   openssl rand -base64 48
RIDEX_JWT_SECRET=

# Where the API answers. Caddy gets its certificate for exactly this name, so it must already
# point at this host before the first boot.
RIDEX_API_DOMAIN=api.example.com

# The admin console's origin, and only it. A wildcard here would let any page call the API with a
# logged-in operator's browser.
RIDEX_CORS_ALLOWED_ORIGINS=https://console.example.com

# Created on first boot if it does not exist. Change the password after the first sign-in.
RIDEX_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RIDEX_BOOTSTRAP_ADMIN_PASSWORD=

# Outbound mail. Any SMTP relay; Brevo's free tier sends 300 a day, which is more than a demo needs.
RIDEX_MAIL_HOST=smtp-relay.brevo.com
RIDEX_MAIL_PORT=587
RIDEX_MAIL_USERNAME=
RIDEX_MAIL_PASSWORD=
RIDEX_MAIL_FROM=no-reply@example.com
# The address printed in every email footer for replies.
RIDEX_MAIL_SUPPORT=support@ridex.com
# Login and TLS default on for a hosted relay; set both false only for a local Mailpit.
# RIDEX_MAIL_AUTH=true
# RIDEX_MAIL_STARTTLS=true

# Razorpay TEST keys. Checkout opens and the test card works; a live key here would charge people
# money during a demo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without a Google key the maps service falls through to OpenRouteService and then to
# Nominatim, both keyless, both rate-limited.
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=

# Which image tag to run. Set by the deploy workflow; latest is what a manual `up -d` picks.
RIDEX_TAG=latest
