# Copy to .env and fill in. Never commit .env.

# Postgres password for the ridex_app role. Must match docker-compose.
RIDEX_APP_PASSWORD=ridex_local

# HMAC-SHA256 signing key for JWTs. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
RIDEX_JWT_SECRET=change-me-please-very-long-secret-key
