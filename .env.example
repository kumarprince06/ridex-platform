# Copy to .env and fill in. Never commit .env.

# Postgres password for the ridex_app role. Must match docker-compose.
RIDEX_APP_PASSWORD=ridex_local

# HMAC-SHA256 signing key for JWTs. Required - the app will not start without it, must be at
# least 32 bytes, and the old placeholder value is rejected outright.
# Generate one with: openssl rand -base64 48
RIDEX_JWT_SECRET=

# Google Maps key for geocoding and the distance matrix. Restrict it by API and by
# IP/referrer in the Google console - an unrestricted key is billable by anyone who finds it.
GOOGLE_MAPS_API_KEY=

# SMTP. Leave these unset for local development: mail then goes to Mailpit on localhost:1025 and
# never leaves the machine, so a typo cannot reach a stranger.
#
# To deliver for real, point them at a relay. Brevo's free tier is 300 a day.
RIDEX_MAIL_HOST=smtp-relay.brevo.com
RIDEX_MAIL_PORT=587
RIDEX_MAIL_USERNAME=
# The SMTP key from Brevo, not your account password.
RIDEX_MAIL_PASSWORD=
RIDEX_MAIL_AUTH=true
RIDEX_MAIL_STARTTLS=true
# Must be an address the relay has verified. Sending as one it has not seen is accepted and then
# silently dropped - no error, nothing in the inbox.
RIDEX_MAIL_FROM=
# The display name beside the address, and the reply-to printed in every footer.
RIDEX_MAIL_FROM_NAME=RideX
RIDEX_MAIL_SUPPORT=support@yourdomain.com
